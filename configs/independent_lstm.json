{
  "protocol": "exploratory-independent-modality-lstm-v1",
  "dataset": "dataset",
  "metadata": "data/metadata/participants.csv",
  "cache": "data/processed",
  "splits": "data/splits/participants.csv",
  "gender_categories": ["female", "male"],
  "seed": 42,
  "audio_kind": "mfcc",
  "audio_time_offset": 0.0,
  "visual_time_offset": 0.0,
  "timestamp_origins_verified": false,
  "allow_unsegmented": true,
  "confidence_threshold": 0.8,
  "bin_seconds": 0.5,
  "window_seconds": 30,
  "stride_seconds": 30,
  "minimum_window_steps": 4,
  "minimum_observed_fraction": 0.5,
  "max_windows_per_participant": 20,
  "hidden_size": 32,
  "dropout": 0.3,
  "batch_size": 8,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "gradient_clip": 1.0,
  "epochs": 50,
  "patience": 8,
  "device": "auto"
}
